NODE_ENV=development
PORT=3000
JWT_SECRET=replace-with-a-long-local-secret

# Local MySQL started by docker-compose.local.yml
DATABASE_URL=mysql://ai_film:liuguang_local@127.0.0.1:3307/ai_film_prod

# LLM / image2 provider
LQ_API_URL=https://lqapi.top/v1
LQ_API_KEY=
LQ_USER_ID=liuguang_internal

# Legacy / optional image providers
VECTORENGINE_API_URL=https://api.vectorengine.ai
VECTORENGINE_API_KEY=
ARK_API_KEY=

# image2 internal API
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Object storage used by generated/uploaded assets
STORAGE_PROVIDER=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=cn-beijing
AWS_S3_BUCKET=liuguang-ai-film-prod
AWS_S3_ENDPOINT=https://tos-s3-cn-beijing.volces.com
AWS_S3_PUBLIC_URL=https://liuguang-ai-film-prod.tos-s3-cn-beijing.volces.com
S3_PUBLIC_READ=true
